rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // config/admin is created by hand in the Firebase console; no client can write it.
    function isAdmin() {
      return signedIn() && me() == get(/databases/$(database)/documents/config/admin).data.email;
    }
    function isMember(c) {
      return signedIn() && me() in get(/databases/$(database)/documents/clients/$(c)).data.members;
    }
    function canUse(c) {
      return isAdmin() || isMember(c);
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /clients/{c} {
      allow read: if isAdmin() || (signedIn() && me() in resource.data.members);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.members is list;
      allow delete: if isAdmin();

      match /scripts/{s} {
        allow read, create, update: if canUse(c);
        allow delete: if isAdmin();

        match /sections/{sec} {
          allow read, write: if canUse(c);
        }
      }

      match /meta/{m} {
        allow read, write: if canUse(c);
      }
    }
  }
}
